{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "description": "Liam Pulsifer's personal site (Solid 2.0). The previous TanStack Start version lives in ./react.",
  "scripts": {
    "dev": "dotenv -e .env.local -- vite --port 3000",
    "dev:local": "bash scripts/dev-local.sh",
    "build": "vite build && node scripts/vercel-output.mjs",
    "start": "dotenv -e .env.local -- node dist/server/node.js",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:local": "bash scripts/e2e-local.sh",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "script": "dotenv -e .env.local -- tsx",
    "db:reset": "supabase db reset --local",
    "db:types": "bash scripts/generate-types.sh",
    "supabase:env": "bash scripts/supabase-env-file.sh",
    "prepare": "ln -sf ../../scripts/pre-commit.sh .git/hooks/pre-commit 2>/dev/null || true"
  },
  "dependencies": {
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "cookie": "^2.0.2",
    "d3-force-3d": "^3.0.6",
    "d3-force-clustering": "^1.0.0",
    "force-graph": "^1.52.0",
    "marked": "^17.0.6",
    "sanitize-html": "^2.18.2",
    "solid-js": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@solidjs/vite-plugin": "^3.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/nft": "^1.11.7",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "filesystem-routing": "0.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
